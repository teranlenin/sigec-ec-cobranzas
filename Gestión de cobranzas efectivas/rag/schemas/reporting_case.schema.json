{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caso sintético de reportería STPR v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "obligation_id", "manager_id", "currency", "opening_principal_usd", "opening_interest_usd", "opening_other_usd", "opening_balance_usd", "days_past_due_at_start", "aging_bucket_version", "simulation_as_of", "dispute_status", "address_token", "phone_token", "email_token", "synthetic", "simulation", "simulation_label"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^CASE-SYN-RPT-[0-9]{5}$"},
    "obligation_id": {"type": "string", "pattern": "^OBL-SYN-RPT-[0-9]{5}$"},
    "manager_id": {"type": "string", "pattern": "^GESTOR-SIM-[0-9]{2}$"},
    "currency": {"const": "USD"},
    "opening_principal_usd": {"type": "number", "minimum": 0},
    "opening_interest_usd": {"type": "number", "minimum": 0},
    "opening_other_usd": {"type": "number", "minimum": 0},
    "opening_balance_usd": {"type": "number", "minimum": 0},
    "days_past_due_at_start": {"type": "integer", "minimum": 1, "maximum": 560},
    "aging_bucket_version": {"const": "dpd-v1"},
    "simulation_as_of": {"type": "string", "format": "date"},
    "dispute_status": {"enum": ["open_simulated", "none_reported_simulated"]},
    "address_token": {"type": "string", "pattern": "^ADDR-SYN-[0-9]{5}-v1$"},
    "phone_token": {"type": "string", "pattern": "^TEL-SYN-[0-9]{5}-v1$"},
    "email_token": {"type": "string", "pattern": "^EMAIL-SYN-[0-9]{5}-v1@example\\.invalid$"},
    "synthetic": {"const": true},
    "simulation": {"const": true},
    "simulation_label": {"const": "SIMULACIÓN — NO USAR EN PRODUCCIÓN"}
  }
}
