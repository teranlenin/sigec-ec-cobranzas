{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evento sintético de reportería STPR v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "case_id", "obligation_id", "cycle_id", "occurred_at", "event_type", "source_ref", "verification_status", "actor_simulated", "schema_version", "synthetic", "simulation", "simulation_label"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVT-SYN-RPT-[A-Za-z0-9_-]+-[0-9]{3,7}$"},
    "case_id": {"type": "string", "pattern": "^CASE-SYN-RPT-[0-9]{5}$"},
    "obligation_id": {"type": "string", "pattern": "^OBL-SYN-RPT-[0-9]{5}$"},
    "cycle_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "event_type": {"enum": ["case_seeded_simulated", "dispute_opened_simulated", "dispute_resolved_simulated", "channel_attempt_simulated", "contact_data_update_simulated", "research_finding_simulated", "payment_recorded_simulated", "commitment_created_simulated", "commitment_status_changed_simulated", "internal_review_simulated"]},
    "source_ref": {"type": "string", "minLength": 1},
    "verification_status": {"enum": ["synthetic_fixture", "declared", "observed", "verified", "disputed", "unknown"]},
    "actor_simulated": {"type": "string"},
    "schema_version": {"const": "reporting-synthetic-v3"},
    "synthetic": {"const": true},
    "simulation": {"const": true},
    "simulation_label": {"const": "SIMULACIÓN — NO USAR EN PRODUCCIÓN"},
    "channel": {"enum": ["phone_call", "sms", "whatsapp_message", "email", "written_notice"]},
    "outcome": {"enum": ["draft_created_not_sent", "reply_simulated", "no_response_simulated"]},
    "delivery_status": {"const": "not_sent"},
    "field_name": {"enum": ["address_token", "phone_token", "email_token"]},
    "old_value_token": {"type": "string"},
    "new_value_token": {"type": "string"},
    "update_source": {"const": "synthetic_investigation"},
    "finding_type": {"enum": ["business_hours_updated", "alternate_channel_declared", "contact_data_confirmed", "internal_note_added"]},
    "finding_summary": {"type": "string"},
    "dispute_status": {"const": "open"},
    "review_outcome": {"const": "human_review_required"},
    "commitment_id": {"type": ["string", "null"]},
    "amount_due_usd": {"type": "number", "exclusiveMinimum": 0},
    "due_at": {"type": "string", "format": "date-time"},
    "commitment_status": {"enum": ["accepted", "pending", "kept", "missed", "cancelled"]},
    "amount_usd": {"type": "number", "exclusiveMinimum": 0},
    "allocation_principal_usd": {"type": "number", "minimum": 0},
    "allocation_interest_usd": {"type": "number", "minimum": 0},
    "allocation_other_usd": {"type": "number", "minimum": 0}
  }
}
